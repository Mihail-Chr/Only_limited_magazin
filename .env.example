# ============================================================
# Only_limited_magazin — конфигурация окружения
# ============================================================
# ВАЖНО: этот файл НЕ коммитить в git. В .gitignore добавить:
#   .env
#   .env.*
#   !.env.example
# ============================================================

# ---------- Общие настройки приложения ----------
APP_NAME=Only_limited_magazin
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow

# ---------- База данных ----------
# Для старта — SQLite, путь относительно корня проекта
DB_DRIVER=sqlite               # sqlite | postgresql
DB_PATH=./db/only_limited.sqlite3
# Если переедете на PostgreSQL — раскомментируйте и заполните:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=only_limited
# DB_USER=only_limited
# DB_PASSWORD=change_me

# ---------- Ozon API: общие настройки ----------
OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_API_TIMEOUT=30            # секунд
OZON_API_RETRY_MAX=3
OZON_API_RETRY_BACKOFF=2       # секунд, экспоненциально
# Лимиты Ozon (примерно): не более N запросов в секунду на метод.
# Точные лимиты зависят от метода — см. документацию.
OZON_RATE_LIMIT_PER_SEC=5

# ---------- Магазин №1: LimitedGames (реальный API) ----------
OZON_STORE_1_CODE=limited_games
OZON_STORE_1_NAME=LimitedGames
OZON_STORE_1_CLIENT_ID=428109
OZON_STORE_1_API_KEY=replace_with_real_api_key
OZON_STORE_1_HAS_API=true
OZON_STORE_1_IS_ACTIVE=true
# Роль ключа: обычно "Admin" или "Read+Write" — уточните в кабинете
OZON_STORE_1_API_ROLE=admin

# ---------- Магазин №2: (реальный API, заполните) ----------
OZON_STORE_2_CODE=store_2
OZON_STORE_2_NAME=Store2
OZON_STORE_2_CLIENT_ID=replace_with_client_id
OZON_STORE_2_API_KEY=replace_with_real_api_key
OZON_STORE_2_HAS_API=true
OZON_STORE_2_IS_ACTIVE=true
OZON_STORE_2_API_ROLE=admin

# ---------- Магазин №3: (пока без API, задел) ----------
OZON_STORE_3_CODE=store_3
OZON_STORE_3_NAME=Store3
OZON_STORE_3_CLIENT_ID=
OZON_STORE_3_API_KEY=
OZON_STORE_3_HAS_API=false
OZON_STORE_3_IS_ACTIVE=true     # живёт в БД, но синхронизация выключена
OZON_STORE_3_API_ROLE=

# ---------- Склад (единый актив компании) ----------
# Даже если склад один — заводим как сущность с id/кодом,
# чтобы кладовщика можно было привязать many-to-many.
WAREHOUSE_1_CODE=main_warehouse
WAREHOUSE_1_NAME=Основной склад
WAREHOUSE_1_DEFAULT_CURRENCY=RUB
# Мультивалютный учёт: базовые валюты, которые допускаем в операциях
WAREHOUSE_1_SUPPORTED_CURRENCIES=RUB;USD;EUR;KZT;BYN
WAREHOUSE_1_IS_ACTIVE=true

# ---------- Роли и пользователи (для seed-скрипта) ----------
# Это не «секреты», а стартовые значения для первичного наполнения БД.
# Реальные пользователи создаются в БД; пароли — хэшами, не в .env.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password

SEED_WAREHOUSE_KEEPER_LOGIN=keeper
SEED_WAREHOUSE_KEEPER_EMAIL=keeper@example.com
SEED_WAREHOUSE_KEEPER_PASSWORD=change_me_strong_password
# Кладовщик может быть на нескольких складах — список кодов через ;
SEED_WAREHOUSE_KEEPER_WAREHOUSES=main_warehouse

SEED_SELLER_1_LOGIN=seller_lg
SEED_SELLER_1_EMAIL=seller_lg@example.com
SEED_SELLER_1_PASSWORD=change_me_strong_password
SEED_SELLER_1_STORE_CODE=limited_games

# SEED_SELLER_2_LOGIN=seller_2
# SEED_SELLER_2_EMAIL=seller_2@example.com
# SEED_SELLER_2_PASSWORD=change_me_strong_password
# SEED_SELLER_2_STORE_CODE=store_2

SEED_AUDITOR_LOGIN=auditor
SEED_AUDITOR_EMAIL=auditor@example.com
SEED_AUDITOR_PASSWORD=change_me_strong_password

# ---------- Пути к данным ----------
DATA_DIR=./data
DATA_RAW_XLSX=./scratch/ozon_reports
DATA_API_RAW=./data/api_raw
DATA_EXPORTS=./data/exports
LOG_DIR=./logs

# ---------- Логирование ----------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | text

# ---------- Секреты приложения ----------
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace_with_generated_secret