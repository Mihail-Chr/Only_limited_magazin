# ============================================================
# Only_limited_magazin — Шаблон конфигурации
# 
# ВАЖНО: 
# 1. Скопируйте этот файл в .env
# 2. Замените все заглушки (your_...) на реальные значения
# 3. НИКОГДА не коммитьте .env в Git (он в .gitignore)
# ============================================================

# ---------- Общие настройки ----------
APP_NAME=Only_limited_magazin
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow

# ---------- База данных ----------
DB_DRIVER=sqlite
DB_PATH=./db/only_limited.sqlite3

# ---------- OZON API (общие настройки) ----------
OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_API_TIMEOUT=30
OZON_API_RETRY_MAX=3
OZON_API_RETRY_BACKOFF=2
OZON_RATE_LIMIT_PER_SEC=5

# ---------- Магазины OZON ----------
# Список кодов магазинов через запятую (эти коды используются для поиска переменных ниже)
OZON_STORES=limited_games,console_games

# Магазин 1: LimitedGames
OZON_LIMITED_GAMES_ID=your_client_id_1
OZON_LIMITED_GAMES_KEY=your_api_key_1
OZON_LIMITED_GAMES_NAME=LimitedGames

# Магазин 2: Console Games
OZON_CONSOLE_GAMES_ID=your_client_id_2
OZON_CONSOLE_GAMES_KEY=your_api_key_2
OZON_CONSOLE_GAMES_NAME=Console Games

# ---------- Магазины Wildberries (пока нет) ----------
# WB_STORES=
# WB_MY_SHOP_ID=
# WB_MY_SHOP_KEY=
# WB_MY_SHOP_NAME=

# ---------- Магазины Яндекс.Маркет (пока нет) ----------
# YM_STORES=
# YM_MY_SHOP_ID=
# YM_MY_SHOP_KEY=
# YM_MY_SHOP_NAME=

# ---------- Магазины Avito (пока нет) ----------
# AVITO_STORES=
# AVITO_MY_SHOP_ID=
# AVITO_MY_SHOP_KEY=
# AVITO_MY_SHOP_NAME=

# ---------- Магазины VK (пока нет) ----------
# VK_STORES=
# VK_MY_SHOP_ID=
# VK_MY_SHOP_KEY=
# VK_MY_SHOP_NAME=

# ---------- Склад ----------
WAREHOUSE_1_CODE=main_warehouse
WAREHOUSE_1_NAME=Основной склад
WAREHOUSE_1_DEFAULT_CURRENCY=RUB
WAREHOUSE_1_SUPPORTED_CURRENCIES=RUB;USD;EUR
WAREHOUSE_1_IS_ACTIVE=true

# ---------- Пути к данным ----------
DATA_DIR=./data
DATA_API_RAW=./data/api_raw
DATA_EXPORTS=./data/exports
LOG_DIR=./logs

# ---------- Логирование ----------
LOG_LEVEL=INFO
LOG_FORMAT=json